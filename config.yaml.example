# Copy this file to ~/.baton/config.yaml and adjust the values you need.

# Harness used when baton starts. Supported values: codex, claude, dsh.
defaultAgent: codex

# Optional: custom Claude Code executable, such as a company wrapper.
claudeExecutable: claude

# Codex must run in headless app-server mode.
codexCommand:
  - codex
  - app-server

# Optional: DeepSeek Harness Agent SDK runtime. The runtime must load
# @deepseek-ai/dsh-sdk-jsonrpc-server; include the absolute Cordis config path
# in the complete argv. These settings are only required when using /dsh.
# dshCommand:
#   - dsh-jsonrpc-agent
#   - /absolute/path/to/cordis.yml
# dshProvider: deepseek-official
dshModel: prod

# Optional: who reviews Codex approvals. Leave unset (the default) to follow
# Codex's own resolution — your ~/.codex/config.toml, profiles and any enterprise
# requirements all apply, and Codex itself defaults to user. Set this only to
# override that for baton-launched sessions. Delegated decisions stay visible as
# per-tool audit receipts and in Agent Status.
# codexApprovalReviewer: auto_review # auto_review | user

# Maximum number of characters injected for session mentions and harness handoffs.
mentionBudgetChars: 4096

# Show agent reasoning in the timeline.
showThoughts: true

# Optional text-generation routing for automatic session titles. By default,
# baton tries the harness that completed the first turn, then the other bundled
# harness. Set a preference when one provider is unavailable, or override the
# provider-specific model used for this small side request.
# textgenPrefer: claude # codex | claude
# textgenModels:
#   claude: haiku
#   codex: your-codex-model-id

# Minimum level persisted to each session.log. Use debug when diagnosing a
# Baton component, Harness adapter, or third-party Plugin.
logLevel: info # debug | info | warn | error
