# Copy this file to ~/.baton/config.yaml and adjust the values you need.

# HarnessTarget used when baton starts. The id must exist under targets.
defaultTarget: codex

# Harness-specific launch settings belong to their Target. The target id is the
# scheduling/session coordinate; multiple targets may use the same Harness.
targets:
  codex:
    harness: codex
    # Codex must run in headless app-server mode.
    command:
      - codex
      - app-server
    # Optional: who reviews Codex approvals. Leave unset to follow Codex's own
    # config/profile/enterprise requirements.
    # approvalReviewer: auto_review # auto_review | user

  # A second account is another Target of the same Harness. Use an absolute
  # path: Baton does not perform shell expansion for values such as ~/.codex2.
  # codex2:
  #   harness: codex
  #   command: [codex, app-server]
  #   env:
  #     CODEX_HOME: /Users/you/.codex2

  claude:
    harness: claude
    # Optional custom Claude Code executable, such as a company wrapper.
    executable: claude

  # claude2:
  #   harness: claude
  #   executable: claude
  #   env:
  #     CLAUDE_CONFIG_DIR: /Users/you/.claude2

  dsh:
    harness: dsh
    # Optional DeepSeek Harness Agent SDK runtime. The runtime must load
    # @deepseek-ai/dsh-sdk-jsonrpc-server. Include the absolute Cordis config
    # path in the complete argv.
    # command:
    #   - dsh-jsonrpc-agent
    #   - /absolute/path/to/cordis.yml
    # provider: deepseek-official
    model: prod

# Maximum number of characters injected for session mentions and Harness handoffs.
mentionBudgetChars: 4096

# Show agent reasoning in the timeline. Toggle at runtime with /thoughts.
showThoughts: true

# Desktop notifications (OSC 9) when a turn finishes or an approval/question is
# pending. Only known-supporting terminals (iTerm2, WezTerm, Kitty, Ghostty,
# Warp) receive them; others stay silent unless bell is explicitly enabled.
# tmux 3.3+ also requires `set -g allow-passthrough on` in ~/.tmux.conf.
# A bare boolean toggles the whole feature.
notifications: true
# notifications:
#   enabled: true
#   bell: false # ring the terminal bell when OSC 9 is unavailable

# Optional text-generation routing for automatic session titles. Values and map
# keys are HarnessTarget ids. By default Baton tries the Target that completed
# the first turn, then the other configured Targets.
# textgenPrefer: claude
# textgenModels:
#   claude: haiku
#   codex: your-codex-model-id

# Minimum level persisted to each session.log.
logLevel: info # debug | info | warn | error
