{
  "name": "@compforge/baton",
  "version": "0.3.30",
  "description": "A terminal-native workspace for coding agents, built on durable sessions.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "license": "Apache-2.0",
  "repository": "github:qiankunli/baton",
  "exports": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "VERSION",
    "config.yaml.example",
    "docs/assets/baton-icon.png",
    "README.md",
    "README.zh-CN.md"
  ],
  "bin": {
    "baton": "src/cli/launcher.cjs"
  },
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test tests && bun run specgen:check",
    "specgen": "specgen . -o spec.json --root .",
    "specgen:check": "specgen . -o spec.json --root . --check",
    "repl": "bun src/cli/main.ts",
    "tui": "bun src/view/chat-tui/main.tsx"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.17",
    "@compforge/spec-case": "0.0.3",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "@compforge/baton-plugin": "0.9.0",
    "@compforge/dsh-agent-sdk": "0.0.1",
    "@lumis-sh/wasm-bash": "0.26.4",
    "@opentui/core": "^0.5.3",
    "@opentui/keymap": "^0.5.3",
    "@opentui/react": "^0.5.3",
    "bun": "^1.3.14",
    "chat-tui": "github:compforge/chat-tui#9836e9a",
    "cron-parser": "^5.6.2",
    "react": "^19.2.7",
    "web-tree-sitter": "0.25.10",
    "yaml": "^2.9.0"
  }
}
