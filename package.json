{
  "name": "@qiankun01/baton",
  "version": "0.0.4",
  "description": "A terminal-native workspace for coding agents, built on durable sessions.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "license": "Apache-2.0",
  "repository": "github:qiankunli/baton",
  "exports": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "config.yaml.example",
    "docs/assets/baton-icon.png",
    "README.md",
    "README.zh-CN.md"
  ],
  "bin": {
    "baton": "src/cli/launcher.cjs"
  },
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test tests",
    "repl": "bun src/cli/main.ts",
    "tui": "bun src/tui/main.tsx"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.17",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.205",
    "@opentui/core": "^0.4.5",
    "@opentui/react": "^0.4.5",
    "@qiankun01/baton-plugin": "workspace:*",
    "bun": "^1.3.14",
    "chat-tui": "github:compforge/chat-tui#0e32b2128fe51debd2c2eea1e0f85600a816cf46",
    "cron-parser": "^5.6.2",
    "react": "^19.2.7",
    "yaml": "^2.9.0"
  }
}
